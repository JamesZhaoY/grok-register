# 默认按文本处理，仓库内统一存 LF
* text=auto eol=lf

# Windows 侧脚本必须是 CRLF：cmd.exe 对 LF 的 .bat 解析不稳定
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# POSIX 脚本必须是 LF，否则 bash 会报 $'\r': command not found
*.sh text eol=lf
Dockerfile text eol=lf
*.yaml text eol=lf
*.yml text eol=lf

# 二进制资源不做行尾转换
*.png binary
*.jpg binary
*.ico binary
*.woff binary
*.woff2 binary
